<mujoco model="xarm7_on_rail">
  <!-- Child model composed into scenes via MjSpec.attach (design 03-sim §3).
       Rail (mavis meshes, travel corrected to the real 0.65 m) + menagerie
       ufactory_xarm7 arm + gripper (pedestal offset removed, TCP site at
       menagerie's 0 0 .172) + D435 wrist-camera mount on link7.
       NO <option> element here: physics options live on the parent scene
       spec only (attach keeps parent values and warns otherwise).
       MJCF-internal qpos order is [rail, j1..j7, gripper...] because the
       rail slide is the kinematic ancestor; the Addressing layer remaps to
       core order (joints q[0:7], rail LAST at q[7]) at every boundary.
       The rail_base body frame IS the rail origin: at rail qpos d the
       link_base frame sits at rail_base + (0, d, 0), satisfying
       T_W_Bi(t) = T_W_ROi + Trans(0, d, 0) from 10-frames §2.2 exactly. -->
  <compiler angle="radian" autolimits="true"/>

  <asset>
    <material name="white" rgba="1 1 1 1"/>
    <material name="gray" rgba="0.753 0.753 0.753 1"/>
    <material name="black" rgba="0.149 0.149 0.149 1"/>

    <mesh file="ufactory_xarm7/assets/link_base.stl"/>
    <mesh file="ufactory_xarm7/assets/link1.stl"/>
    <mesh file="ufactory_xarm7/assets/link2.stl"/>
    <mesh file="ufactory_xarm7/assets/link3.stl"/>
    <mesh file="ufactory_xarm7/assets/link4.stl"/>
    <mesh file="ufactory_xarm7/assets/link5.stl"/>
    <mesh file="ufactory_xarm7/assets/link6.stl"/>
    <mesh file="ufactory_xarm7/assets/link7.stl"/>
    <mesh file="ufactory_xarm7/assets/end_tool.stl"/>
    <mesh file="ufactory_xarm7/assets/base_link.stl"/>
    <mesh file="ufactory_xarm7/assets/left_outer_knuckle.stl"/>
    <mesh file="ufactory_xarm7/assets/left_finger.stl"/>
    <mesh file="ufactory_xarm7/assets/left_inner_knuckle.stl"/>
    <mesh file="ufactory_xarm7/assets/right_outer_knuckle.stl"/>
    <mesh file="ufactory_xarm7/assets/right_finger.stl"/>
    <mesh file="ufactory_xarm7/assets/right_inner_knuckle.stl"/>
    <mesh file="rail/linear_motor_rail.stl"/>
    <mesh file="rail/linear_motor_platform.stl"/>
    <mesh file="cameras/d435_with_cam_stand.stl"/>
  </asset>

  <default>
    <default class="xarm7">
      <geom type="mesh" material="white"/>
      <joint axis="0 0 1" armature="0.1" range="-6.28319 6.28319" frictionloss="1"/>
      <general biastype="affine" ctrlrange="-6.28319 6.28319"/>
      <default class="size1">
        <joint damping="10"/>
        <general gainprm="1500" biasprm="0 -1500 -150" forcerange="-50 50"/>
      </default>
      <default class="size2">
        <joint damping="5"/>
        <general gainprm="1000" biasprm="0 -1000 -100" forcerange="-30 30"/>
      </default>
      <default class="size3">
        <joint damping="2"/>
        <general gainprm="800" biasprm="0 -800 -80" forcerange="-20 20"/>
      </default>
      <default class="spring_link">
        <joint range="0 0.85" stiffness="0.05" springref="2.62" damping="0.00125"/>
      </default>
      <default class="driver">
        <joint range="0 0.85" armature="0.005" damping="0.1" solreflimit="0.005 1"/>
      </default>
      <default class="follower">
        <joint range="0 0.85" solreflimit="0.005 1"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>
        <default class="pad_box1">
          <geom type="box" friction="0.7" solimp="0.95 0.99 0.001" solref="0.004 1" mass="0" priority="1"
            size="0.015 0.002 0.0095" rgba="0.0 0.1 0.7 1"/>
        </default>
        <default class="pad_box2">
          <geom type="box" friction="0.6" solimp="0.95 0.99 0.001" solref="0.004 1" mass="0" priority="1"
            size="0.015 0.002 0.0095" rgba="0.0 0.5 0.5 1"/>
        </default>
      </default>
      <site size="0.001" rgba="1 0 0 1" group="4"/>
    </default>
  </default>

  <worldbody>
    <!-- rail_base frame == rail origin (link_base pose at rail qpos 0).
         The along-travel mesh offset places the extrusion's WIDE END FACE (the
         14 cm end plate at the travel-zero end) 0.187 m from the base centre,
         MEASURED on the real cell (operator: wide face -> base cylinder centre
         18.5-19 cm at the homed carriage; 2026-09-05, end feature corrected
         2026-09-06). The 3.2 cm boss protrudes a further 2.0 cm (0.2075 m);
         anchoring THAT by mistake on 09-05 moved the drawn rail 20 mm. The mavis
         reference model implied 0.2476 m to the boss and centred the platform on
         the mesh at mid-travel: a 4 cm error that put the twin's arms too far
         from the zero end (03-sim 4.3). The mesh is 1.0926 m against the real
         1.075 m, so anchoring the zero end leaves the FAR end 0.3 cm long --
         deliberate: the zero end is the one with the obstacle. -->
    <body name="rail_base">
      <inertial pos="0 0 0" mass="10" diaginertia="1 1 1"/>
      <geom name="rail" type="mesh" material="black" mesh="linear_motor_rail"
        pos="0.038245 0.365093 -0.064988"/>
      <body name="rail_platform">
        <inertial pos="0 0 0" mass="1" diaginertia="1 1 1"/>
        <!-- Direct [0, 0.65] range: MJCF qpos == app-level rail meters ==
             hardware absolute rail mm/1000. NOT the mavis ±0.37. -->
        <joint name="rail_joint" type="slide" axis="0 1 0" range="0 0.65"
          stiffness="50" damping="50" armature="0.1"/>
        <geom name="rail_platform" type="mesh" material="black" mesh="linear_motor_platform"/>
        <!-- menagerie xarm7.xml body tree; link_base pos="0 0 .12" pedestal
             offset REMOVED (the arm bolts straight onto the platform). -->
        <body name="link_base" childclass="xarm7">
          <inertial pos="-0.021131 -0.0016302 0.056488" quat="0.696843 0.20176 0.10388 0.680376" mass="0.88556"
            diaginertia="0.00382023 0.00335282 0.00167725"/>
          <geom mesh="link_base"/>
          <body name="link1" pos="0 0 0.267">
            <inertial pos="-0.0002 0.02905 -0.01233" quat="0.978953 -0.202769 -0.00441617 -0.0227264" mass="2.382"
              diaginertia="0.00569127 0.00533384 0.00293865"/>
            <joint name="joint1" class="size1"/>
            <geom mesh="link1"/>
            <body name="link2" quat="1 -1 0 0">
              <inertial pos="0.00022 -0.12856 0.01735" quat="0.50198 0.86483 -0.00778841 0.00483285" mass="1.869"
                diaginertia="0.00959898 0.00937717 0.00201315"/>
              <joint name="joint2" range="-2.059 2.0944" class="size1"/>
              <geom mesh="link2"/>
              <body name="link3" pos="0 -0.293 0" quat="1 1 0 0">
                <inertial pos="0.0466 -0.02463 -0.00768" quat="0.913819 0.289775 0.281481 -0.0416455" mass="1.6383"
                  diaginertia="0.00351721 0.00294089 0.00195868"/>
                <joint name="joint3" class="size2"/>
                <geom mesh="link3"/>
                <body name="link4" pos="0.0525 0 0" quat="1 1 0 0">
                  <inertial pos="0.07047 -0.11575 0.012" quat="0.422108 0.852026 -0.126025 0.282832" mass="1.7269"
                    diaginertia="0.00657137 0.00647948 0.00186763"/>
                  <joint name="joint4" range="-0.19198 3.927" class="size2"/>
                  <geom mesh="link4"/>
                  <body name="link5" pos="0.0775 -0.3425 0" quat="1 1 0 0">
                    <inertial pos="-0.00032 0.01604 -0.026" quat="0.999311 -0.0304457 0.000577067 0.0212082" mass="1.3203"
                      diaginertia="0.00534729 0.00499076 0.0013489"/>
                    <joint name="joint5" class="size2"/>
                    <geom mesh="link5"/>
                    <body name="link6" quat="1 1 0 0">
                      <inertial pos="0.06469 0.03278 0.02141" quat="-0.217672 0.772419 0.16258 0.574069" mass="1.325"
                        diaginertia="0.00245421 0.00221646 0.00107273"/>
                      <joint name="joint6" range="-1.69297 3.14159" class="size3"/>
                      <geom mesh="link6"/>
                      <body name="link7" pos="0.076 0.097 0" quat="1 -1 0 0">
                        <inertial pos="0 -0.00677 -0.01098" quat="0.487612 0.512088 -0.512088 0.487612" mass="0.17"
                          diaginertia="0.000132176 9.3e-05 5.85236e-05"/>
                        <joint name="joint7" class="size3"/>
                        <geom material="gray" mesh="end_tool"/>
                        <!-- D435 wrist camera + mount. Camera POS is MEASURED
                             (2026-09-06): solved from four tape-referenced dots
                             on the table with the rotation held at the model's
                             value (independently confirmed by the observed
                             perspective convergence). The reference model's
                             guess (0.07 0 0.05) was ~22 mm sideways and ~20 mm
                             too far from the flange; that was the entire visible
                             twin-overlay offset (03-sim 4.3). fovy 57 is the
                             depth FOV and is overridden by the real colour
                             intrinsics in the overlay. Mount geom is visual-only:
                             the stand mesh overlaps the gripper base hull and
                             would otherwise produce a permanent contact. -->
                        <body name="d435_mount">
                          <geom name="d435" class="visual" material="gray" mesh="d435_with_cam_stand"/>
                          <camera name="wrist_cam" pos="0.06832 -0.02220 0.02945" quat="0 0.7071 0.7071 0" fovy="57"/>
                        </body>
                        <body name="xarm_gripper_base_link" quat="0 0 0 1">
                          <inertial pos="-0.00065489 -0.0018497 0.048028" quat="0.997403 -0.0717512 -0.0061836 0.000477479"
                            mass="0.54156" diaginertia="0.000471093 0.000332307 0.000254799"/>
                          <geom mesh="base_link"/>
                          <body name="left_outer_knuckle" pos="0 0.035 0.059098">
                            <inertial pos="0 0.021559 0.015181" quat="0.47789 0.87842 0 0" mass="0.033618"
                              diaginertia="1.9111e-05 1.79089e-05 1.90167e-06"/>
                            <joint name="left_driver_joint" axis="1 0 0" class="driver"/>
                            <geom material="black" mesh="left_outer_knuckle"/>
                            <body name="left_finger" pos="0 0.035465 0.042039">
                              <inertial pos="0 -0.016413 0.029258" quat="0.697634 0.115353 -0.115353 0.697634"
                                mass="0.048304" diaginertia="1.88037e-05 1.7493e-05 3.56792e-06"/>
                              <joint name="left_finger_joint" axis="-1 0 0" class="follower"/>
                              <geom class="visual" material="black" mesh="left_finger"/>
                              <geom class="pad_box1" name="left_finger_pad_1" pos="0 -0.024003 0.032"/>
                              <geom class="pad_box2" name="left_finger_pad_2" pos="0 -0.024003 0.050"/>
                            </body>
                          </body>
                          <body name="left_inner_knuckle" pos="0 0.02 0.074098">
                            <inertial pos="1.86601e-06 0.0220468 0.0261335" quat="0.664139 -0.242732 0.242713 0.664146"
                              mass="0.0230126" diaginertia="8.34216e-06 6.0949e-06 2.75601e-06"/>
                            <joint name="left_inner_knuckle_joint" axis="1 0 0" class="spring_link"/>
                            <geom material="black" mesh="left_inner_knuckle"/>
                          </body>
                          <body name="right_outer_knuckle" pos="0 -0.035 0.059098">
                            <inertial pos="0 -0.021559 0.015181" quat="0.87842 0.47789 0 0" mass="0.033618"
                              diaginertia="1.9111e-05 1.79089e-05 1.90167e-06"/>
                            <joint name="right_driver_joint" axis="-1 0 0" class="driver"/>
                            <geom material="black" mesh="right_outer_knuckle"/>
                            <body name="right_finger" pos="0 -0.035465 0.042039">
                              <inertial pos="0 0.016413 0.029258" quat="0.697634 -0.115356 0.115356 0.697634"
                                mass="0.048304" diaginertia="1.88038e-05 1.7493e-05 3.56779e-06"/>
                              <joint name="right_finger_joint" axis="1 0 0" class="follower"/>
                              <geom class="visual" material="black" mesh="right_finger"/>
                              <geom class="pad_box1" name="right_finger_pad_1" pos="0 0.024003 0.032"/>
                              <geom class="pad_box2" name="right_finger_pad_2" pos="0 0.024003 0.050"/>
                            </body>
                          </body>
                          <body name="right_inner_knuckle" pos="0 -0.02 0.074098">
                            <inertial pos="1.866e-06 -0.022047 0.026133" quat="0.66415 0.242702 -0.242721 0.664144"
                              mass="0.023013" diaginertia="8.34209e-06 6.0949e-06 2.75601e-06"/>
                            <joint name="right_inner_knuckle_joint" axis="-1 0 0" class="spring_link"/>
                            <geom material="black" mesh="right_inner_knuckle"/>
                          </body>
                          <!-- TCP: menagerie 0 0 .172 (mavis's .165 rejected) -->
                          <site name="link_tcp" pos="0 0 .172"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="right_inner_knuckle" body2="right_outer_knuckle"/>
    <exclude body1="right_inner_knuckle" body2="right_finger"/>
    <exclude body1="left_inner_knuckle" body2="left_outer_knuckle"/>
    <exclude body1="left_inner_knuckle" body2="left_finger"/>
    <!-- MuJoCo disables the parent-child auto-filter when the parent is
         welded to the world, leaving a permanent dist~0.0002 m contact
         (verified gotcha, 03-sim §8) — exclude explicitly. -->
    <exclude body1="link_base" body2="link1"/>
    <exclude body1="rail_base" body2="rail_platform"/>
    <!-- Adjacent-hull pairs flagged by the twin's at-home inflation audit
         (phase-03, delta = 0.025 m): mechanically constrained neighbours
         that sit inside the inflation band forever. -->
    <exclude body1="link_base" body2="rail_base"/>
    <exclude body1="left_outer_knuckle" body2="right_outer_knuckle"/>
    <exclude body1="left_finger" body2="xarm_gripper_base_link"/>
    <exclude body1="right_finger" body2="xarm_gripper_base_link"/>
  </contact>

  <tendon>
    <fixed name="split">
      <joint joint="right_driver_joint" coef="0.5"/>
      <joint joint="left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <connect anchor="0 0.015 0.015" body1="right_finger" body2="right_inner_knuckle" solref="0.005 1"/>
    <connect anchor="0 -0.015 0.015" body1="left_finger" body2="left_inner_knuckle" solref="0.005 1"/>
    <joint joint1="left_driver_joint" joint2="right_driver_joint" polycoef="0 1 0 0 0" solref="0.005 1"/>
  </equality>

  <actuator>
    <general name="rail" joint="rail_joint" ctrlrange="0 0.65" forcerange="-50 50" gear="50"/>
    <general name="act1" joint="joint1" class="size1"/>
    <general name="act2" joint="joint2" class="size1" ctrlrange="-2.059 2.0944"/>
    <general name="act3" joint="joint3" class="size2"/>
    <general name="act4" joint="joint4" class="size2" ctrlrange="-0.19198 3.927"/>
    <general name="act5" joint="joint5" class="size2"/>
    <general name="act6" joint="joint6" class="size3" ctrlrange="-1.69297 3.14159"/>
    <general name="act7" joint="joint7" class="size3"/>
    <general name="gripper" tendon="split" forcerange="-50 50" ctrlrange="0 255" biastype="affine" gainprm="0.333"
      biasprm="0 -100 -10"/>
  </actuator>

  <!-- home = menagerie home posture, rail mid-travel (0.325 m).
       qpos: [rail, j1..j7, 6 gripper joints]; ctrl: [rail, act1..7, gripper] -->
  <keyframe>
    <key name="home" qpos="0.325 0 -0.247 0 0.909 0 1.15644 0 0 0 0 0 0 0"
      ctrl="0.325 0 -0.247 0 0.909 0 1.15644 0 0"/>
  </keyframe>
</mujoco>
